#
# The dictionary for the daemon's fuzz targets: the tokens the daemon's
# parsers look for. libFuzzer splices these into the inputs it mutates,
# so a statement that starts with SELECT, a JSON document that opens with
# a brace, a vector in brackets and a frame with its magic are all one
# mutation away from being tried.
kw_select="SELECT"
kw_insert="INSERT"
kw_update="UPDATE"
kw_delete="DELETE"
kw_replace="REPLACE"
kw_drop="DROP"
kw_with="WITH"
kw_recursive="RECURSIVE"
kw_from="FROM"
kw_where="WHERE"
kw_union="UNION"
kw_all="ALL"
kw_into="OUTFILE"
kw_dumpfile="DUMPFILE"
kw_values="VALUES"
kw_table="TABLE"
kw_explain="EXPLAIN"
kw_show="SHOW"
kw_grant="GRANT"
kw_call="CALL"
kw_extern="EXTERN"
kw_table="TABLE"
fn_audit_log="fractal_audit_log("
fn_ledger="fractal_ledger_"
fn_lock="fractal_lock_destructive"
fn_diversify="fractal_diversify_"
fn_agent="fractal_agent_"
fn_sql_agent="fractal_sql_agent"
fn_store="fractal_store_"
json_open_brace="{"
json_close_brace="}"
json_open_bracket="["
json_close_bracket="]"
json_quote="\""
json_colon=":"
json_comma=","
json_null="null"
json_true="true"
json_false="false"
json_escape="\\"
json_unicode="\\u"
csv_comma=","
csv_semicolon=";"
csv_space=" "
csv_tab="	"
csv_newline=" "
num_zero="0"
num_one="1"
num_neg="-1"
num_exp="1e"
num_nan="nan"
num_inf="inf"
num_hex="0x"
frame_magic="FSQ1"
frame_version="\x02\x00"
tlv_null="\x00"
tlv_string="\x01"
tlv_int="\x02"
tlv_real="\x03"
tlv_decimal="\x04"
tlv_binary="\x05"
cfg_equals=" = "
cfg_comment="#"
cfg_line_comment="--"
cfg_block_comment="/*"
